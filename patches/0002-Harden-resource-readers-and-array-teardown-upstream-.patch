From d23e9e034e8e9a1b74a6cfde7e12cd4107f457bb Mon Sep 17 00:00:00 2001
From: test <t@t>
Date: Sun, 13 Sep 2026 11:23:43 +0000
Subject: [PATCH 2/4] Harden resource readers and array teardown (upstream
 a45e99fb)

- Lzss::Decode DECODE_HANDLE_FETCH checks the input bound before reading, so a
  truncated LZSS stream no longer reads one byte past the buffer.
- FileSystem::TryDecryptFromTable reports the real decrypted size (size - 4) under
  TH08_MODERN_PORT, keeping bounded modern readers inside the returned block.
- New ZUN_DELETE_ARRAY / ZUN_DELETE_ARRAY2 and SAFE_DELETE_LEGACY_ARRAY macros pair
  legacy array allocations with delete[] in modern builds; the scalar delete path is
  preserved when TH08_MODERN_PORT is not defined.
---
 src/Global.cpp      | 10 +++++++++-
 src/Global.hpp      | 18 +++++++++++++++++-
 src/MusicRoom.cpp   |  2 +-
 src/TitleScreen.cpp |  4 ++--
 src/main.cpp        |  4 ++++
 src/pbg/Lzss.cpp    |  2 +-
 src/zwave.cpp       | 21 +++++++++++++++------
 7 files changed, 49 insertions(+), 12 deletions(-)

diff --git a/src/Global.cpp b/src/Global.cpp
index 693607b..f3d6125 100644
--- a/src/Global.cpp
+++ b/src/Global.cpp
@@ -898,7 +898,7 @@ DIFFABLE_STATIC_ARRAY_ASSIGN(DecryptParams, 8, g_DecryptParams) = {
 DIFFABLE_STATIC_ARRAY_ASSIGN(u8, 3, g_CryptSignature) = {0x85, 0xa4, 0xda};
 
 #pragma var_order(rawData, decryptedData, i)
-LPBYTE FileSystem::TryDecryptFromTable(LPBYTE inData, LPINT unused, i32 size)
+LPBYTE FileSystem::TryDecryptFromTable(LPBYTE inData, LPINT fileSize, i32 size)
 {
     LPBYTE rawData = inData;
     LPBYTE decryptedData;
@@ -919,6 +919,14 @@ LPBYTE FileSystem::TryDecryptFromTable(LPBYTE inData, LPINT unused, i32 size)
         // 4 bytes are skipped to exclude the encryption signature
         decryptedData = Decrypt(rawData + 4, size - 4, g_DecryptParams[i].xorValue, g_DecryptParams[i].xorValueInc,
                                 g_DecryptParams[i].chunkSize, g_DecryptParams[i].maxBytesToDecrypt);
+        // Возвращённый блок больше на 4 байта заголовка шифрования: сообщаем
+        // точный размер, чтобы современные bounded-читатели не читали за концом.
+#ifdef TH08_MODERN_PORT
+        if (fileSize != NULL)
+        {
+            *fileSize = size - 4;
+        }
+#endif
         g_ZunMemory.Free(inData);
         return decryptedData;
     }
diff --git a/src/Global.hpp b/src/Global.hpp
index 149925a..2567448 100644
--- a/src/Global.hpp
+++ b/src/Global.hpp
@@ -32,9 +32,25 @@ namespace th08
     g_ZunMemory.RemoveFromRegistry(p);                                                                                 \
     delete p;                                                                                                          \
     p = NULL;
+#ifdef TH08_MODERN_PORT
+#define ZUN_DELETE_ARRAY(p)                                                                                            \
+    g_ZunMemory.RemoveFromRegistry(p);                                                                                 \
+    delete[] p;                                                                                                        \
+    p = NULL;
+#else
+// Скалярный delete сохранён для нативной точности VC7-сборки.
+#define ZUN_DELETE_ARRAY(p) ZUN_DELETE(p)
+#endif
 #define ZUN_DELETE2(p)                                                                                                 \
     delete p;                                                                                                          \
     p = NULL;
+#ifdef TH08_MODERN_PORT
+#define ZUN_DELETE_ARRAY2(p)                                                                                           \
+    delete[] p;                                                                                                        \
+    p = NULL;
+#else
+#define ZUN_DELETE_ARRAY2(p) ZUN_DELETE2(p)
+#endif
 
 #define ZUN_FREE(p)                                                                                                    \
     g_ZunMemory.Free(p);                                                                                               \
@@ -198,7 +214,7 @@ void ResetKeyboard();
 namespace FileSystem
 {
 LPBYTE Decrypt(LPBYTE inData, i32 size, u8 xorValue, u8 xorValueInc, i32 chunkSize, i32 maxBytes);
-LPBYTE TryDecryptFromTable(LPBYTE inData, LPINT unused, i32 size);
+LPBYTE TryDecryptFromTable(LPBYTE inData, LPINT fileSize, i32 size);
 LPBYTE Encrypt(LPBYTE inData, i32 size, u8 xorValue, u8 xorValueInc, i32 chunkSize, i32 maxBytes);
 LPBYTE OpenFile(LPCSTR path, i32 *fileSize, BOOL isExternalResource);
 BOOL CheckIfFileAlreadyExists(LPCSTR path);
