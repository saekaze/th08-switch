     DSBPOSITIONNOTIFY *aPosNotify = NULL;
     LPDIRECTSOUNDNOTIFY pDSNotify = NULL;
@@ -345,7 +352,7 @@ HRESULT CStreamingSound::InitSoundBuffers()
         }
 
         SAFE_RELEASE(pDSNotify);
-        SAFE_DELETE(aPosNotify);
+        SAFE_DELETE_LEGACY_ARRAY(aPosNotify);
     }
 
